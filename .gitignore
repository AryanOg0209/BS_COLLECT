.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# Real customer financial data must never be committed.
# Only synthetic fixtures under tests/fixtures/ and data/synthetic/ are allowed.
data/*
!data/synthetic/
!data/README.md
*.db
*.sqlite
*.sqlite3
*.xlsx
*.xls
*.csv
!tests/fixtures/*.csv
!data/synthetic/*.csv
!data/synthetic/*.xlsx

.DS_Store
.env

# Generated demo kits (regenerate with: collectos demo ./demo-kit)
demo-kit/
*-kit/

# Commercial material (pricing, outreach, prospect lists) must never be pushed to a public repo
sales-kit/

# Third-party Claude Code skills (nextlevelbuilder/ui-ux-pro-max-skill, MIT). Local tools, not part of this project.
.claude/skills/

# Local MCP tool config (reads API_KEY_21ST from your environment; never put the key in this file)
.mcp.json
